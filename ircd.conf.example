# ScratchIRCd runtime configuration
# Copy this file to ircd.conf and adjust values as needed.

server_name = scratch.local
network_name = ScratchNet

# Empty means listen on all available IPv4 and IPv6 addresses.
bind_address =
port = 6667

max_clients = 1024
dns_timeout_seconds = 5

# Optional connection password. Leave empty to disable PASS enforcement.
server_password =

# Server information files.
motd_file = motd.txt
rules_file = rules.txt

# ADMIN command information.
admin_location1 =
admin_location2 =
admin_email =

# All ScratchIRCd SQLite databases live under data/. Ordinary IRC operators
# are NOT configured in this file. They are managed by the network
# administrator through OPERADD / OPERDEL / OPERSET / OPERLIST.
operators_db = data/operators.db

# Bootstrap network administrator only.
# Generate netadmin_password_hash with:
#   ./build/scratchircd-mkpasswd 'your password'
#
# The host mask is checked against the effective IRC client host/IP, not the
# physical WebIRC gateway identity. Leave name/hash empty to disable bootstrap
# netadmin authentication.
netadmin_name =
netadmin_password_hash =
netadmin_hostmask = *!*@*
netadmin_vhost =
