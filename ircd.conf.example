# ScratchIRCd runtime configuration
# Copy this file to ircd.conf and adjust values as needed.

server_name = scratch.local
network_name = ScratchNet
bind_address =
port = 6667

tls_port = 6697
tls_cert_file =
tls_key_file =

max_clients = 1024
dns_timeout_seconds = 5

# PING-cookie anti-spoofing. After NICK establishes a usable CTCP target the
# server sends the random PING cookie followed immediately by CTCP VERSION.
# Registration waits for the matching PONG. Clients that do not answer VERSION
# cannot JOIN or privately message non-operators. Authenticated WebIRC clients
# are additionally queried with CTCP WEBSITE.
nospoof = yes
nospoof_timeout_seconds = 30

# Authorized WebIRC gateways.
# webirc_gateway = 127.0.0.1 change-me
# webirc_gateway = 2001:db8::10 another-secret

dnsbl_timeout_seconds = 5
# dnsbl = Spamhaus zen.spamhaus.org
# dnsbl = DroneBL dnsbl.dronebl.org

geoip_city_db = data/GeoLite2-City.mmdb
geoip_asn_db = data/GeoLite2-ASN.mmdb

server_password =
motd_file = motd.txt
rules_file = rules.txt
admin_location1 =
admin_location2 =
admin_email =

operators_db = data/operators.db
bans_db = data/bans.db
nickserv_db = data/nickserv.db
chanserv_db = data/chanserv.db
memoserv_db = data/memoserv.db
history_db = data/history.db

kline_default_duration_seconds = 3600
kline_default_reason = Temporary KLINE
zline_default_duration_seconds = 3600
zline_default_reason = Temporary ZLINE

history_limit = 100
memoserv_quota = 100
memoserv_retention_days = 90

sendmail_path =
mail_from =
nickserv_reset_seconds = 1800
nickserv_verify_seconds = 86400

# Bootstrap network administrator only. Ordinary operators live in operators_db.
netadmin_name =
netadmin_password_hash =
netadmin_hostmask = *!*@*
netadmin_vhost =
