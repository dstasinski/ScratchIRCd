# ScratchIRCd runtime configuration
# Copy this file to ircd.conf and adjust values as needed.

server_name = scratch.local
network_name = ScratchNet
bind_address =
port = 6667

tls_port = 6697
tls_cert_file =
tls_key_file =

max_clients = 1024

# Maximum number of live channels. Empty channels are destroyed immediately,
# returning capacity to this pool. Valid range: 1-262144. Changing it requires
# RESTART so the resource ceiling cannot shift underneath live channel state.
max_channels = 4096

# Maximum simultaneous connections sharing one real client IP. Set to 0 to
# disable the per-IP limit. Trusted WebIRC gateway source IPs are automatically
# exempt so the gateway itself is never treated as one end user. After WEBIRC
# authentication, the supplied end-user IP is checked against this limit.
max_connections_per_ip = 0
# connection_limit_exempt_ip = 192.0.2.10
# connection_limit_exempt_ip = 2001:db8::20

# Maximum time from socket acceptance until IRC registration completes.
registration_timeout_seconds = 60

# Maximum unsent data retained per client when a nonblocking socket applies
# backpressure. Slow clients exceeding this bounded SendQ are disconnected.
# Valid range: 4096-1048576 bytes. Changing it requires RESTART.
output_queue_max_bytes = 65536

dns_timeout_seconds = 5

# PING-cookie anti-spoofing.
nospoof = yes
nospoof_timeout_seconds = 30

# MODE +x cloaking. cloak_key must be a private random secret of at least
# 16 characters; an empty key disables +x cloak generation. Changing either
# value requires RESTART because cloaks are used in public identity and bans.
cloak_prefix = dru
cloak_key =

# Authorized WebIRC gateways.
# webirc_gateway = 127.0.0.1 change-me
# webirc_gateway = 2001:db8::10 another-secret

dnsbl_timeout_seconds = 5
# dnsbl = Spamhaus zen.spamhaus.org
# dnsbl = DroneBL dnsbl.dronebl.org

geoip_city_db = data/GeoLite2-City.mmdb
geoip_asn_db = data/GeoLite2-ASN.mmdb

server_password =
motd_file = motd.txt
rules_file = rules.txt
admin_location1 =
admin_location2 =
admin_email =

operators_db = data/operators.db
bans_db = data/bans.db
nickserv_db = data/nickserv.db
chanserv_db = data/chanserv.db
memoserv_db = data/memoserv.db
history_db = data/history.db

kline_default_duration_seconds = 3600
kline_default_reason = Temporary KLINE
zline_default_duration_seconds = 3600
zline_default_reason = Temporary ZLINE

# Maximum rows returned by one CHATHISTORY request.
history_limit = 100
# Persistent IRCv3 channel history is pruned approximately every five minutes.
# A retention value of 0 disables age-based pruning, but history_max_rows is
# always enforced. SQLite reuses freed pages rather than VACUUMing the hot DB.
history_retention_days = 30
history_max_rows = 250000

# Channel text logging uses a durable SQLite queue before five-minute text-file
# flushes. Existing queued events are never discarded to enforce this limit.
# If the backlog reaches the ceiling, new log events are refused until the
# backlog flushes and IRCops receive rate-limited admin/flood SNOTICES.
channel_log_queue_max_rows = 250000

# Per-recipient mailbox quota and per-sender retained/outstanding quota.
# The sender quota limits total retained memos across all recipients so one
# account cannot monopolize the global memo database.
memoserv_quota = 100
memoserv_sender_quota = 500
memoserv_retention_days = 90

# Service fair-share limits. A value of 0 disables the corresponding fair-share
# limit, but the compile-time global database ceilings remain enforced.
# NickServ registration throttles use the final real client IP (including the
# end-user IP supplied by an authorized WebIRC gateway) and are kept only in
# bounded process memory; registration IPs are not persisted in NickServ DB.
nickserv_registrations_per_ip = 5
nickserv_registration_window_seconds = 3600
# Mail-producing SET EMAIL and RESET <account> requests have a separate IP
# throttle. The global per-minute limit additionally bounds detached sendmail
# worker creation even when requests originate from many different IPs.
nickserv_mail_requests_per_ip = 5
nickserv_mail_window_seconds = 900
nickserv_mail_global_per_minute = 60

# Argon2 password hashing/verification is intentionally expensive, so all
# client-triggered Argon2 work shares bounded per-IP and global budgets.
# Setting a limit to 0 disables only that layer of the fair-share policy.
argon2_ops_per_ip = 10
argon2_window_seconds = 60
argon2_global_ops_per_minute = 60
argon2_global_burst_per_second = 8

sendmail_path =
mail_from =
nickserv_reset_seconds = 1800
nickserv_verify_seconds = 86400

# Bootstrap network administrator only. Ordinary operators live in operators.db.
netadmin_name =
netadmin_password_hash =
netadmin_hostmask = *!*@*
netadmin_vhost =
